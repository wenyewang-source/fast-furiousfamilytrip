        {
          "time": "10:55–13:00",
          "text": "Arrive, collect luggage, walk to the airport rental facility, and install car seats. Allow 90–120 minutes; avoid a tight lunch reservation.",
          "type": "transfer",
          "placeId": "aus",
          "id": "d1-item2"
        },
        {
          "time": "13:00",
          "text": "la Barbecue if the line is manageable. Share brisket, ribs and sausage. If delayed, choose an easy lunch and move BBQ to another open day. Friday service currently 11:00–18:00; food can sell out.",
          "type": "restaurant",
          "placeId": "labarbecue",
          "ticketIds": [
            "la-info"
          ],
          "id": "d1-item3"
        },
        {
